+/* Takes any D3D11 device; the shared textures' runtime data then shows whether it really is
+ * DXMT's. */
+static XrResult dxmt_init(wine_XrInstance *instance, ID3D11Device *device) {
+  struct metal_openxr_params params = {.op = METAL_CREATE_QUEUE};
+  D3DKMT_OPENADAPTERFROMLUID open_adapter = {0};
+  D3DKMT_CREATEDEVICE create_device = {0};
+  IDXGIDevice *dxgi_device;
+  IDXGIAdapter *adapter;
+  DXGI_ADAPTER_DESC desc;
+  HRESULT hr;
+
+  dxmt_release(instance);
+  ID3D11Device_AddRef(device);
+  instance->dxmt_device = device;
+
+  if (FAILED(ID3D11Device_QueryInterface(device, &IID_IDXGIDevice, (void **)&dxgi_device))) {
+    goto fail;
+  }
+  hr = IDXGIDevice_GetAdapter(dxgi_device, &adapter);
+  IDXGIDevice_Release(dxgi_device);
+  if (FAILED(hr)) {
+    goto fail;
+  }
+  hr = IDXGIAdapter_GetDesc(adapter, &desc);
+  IDXGIAdapter_Release(adapter);
+  if (FAILED(hr)) {
+    goto fail;
+  }
+  open_adapter.AdapterLuid = desc.AdapterLuid;
+  if (D3DKMTOpenAdapterFromLuid(&open_adapter)) {
+    goto fail;
+  }
+  create_device.hAdapter = open_adapter.hAdapter;
+  if (D3DKMTCreateDevice(&create_device)) {
+    goto fail;
+  }
+  instance->dxmt_kmt_device = create_device.hDevice;
+
+  if (!(instance->metal_queue = metal_call(&params))) {
