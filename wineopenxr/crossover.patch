+/* The DXGI formats with a Metal pixel format of the same layout. D24S8 has no such format on
+ * Apple GPUs, and depth swapchains are never copied, so it rides on Depth32Float_Stencil8. */
+static const struct {
+  DXGI_FORMAT dxgi;
+  int64_t metal;
+} dxgi_metal_formats[] = {
+    {DXGI_FORMAT_R8G8B8A8_UNORM, 70},
+    {DXGI_FORMAT_R8G8B8A8_UNORM_SRGB, 71},
+    {DXGI_FORMAT_B8G8R8A8_UNORM, 80},
+    {DXGI_FORMAT_B8G8R8A8_UNORM_SRGB, 81},
+    {DXGI_FORMAT_R10G10B10A2_UNORM, 90},
+    {DXGI_FORMAT_R11G11B10_FLOAT, 92},
+    {DXGI_FORMAT_R16G16B16A16_FLOAT, 115},
+    {DXGI_FORMAT_D16_UNORM, 250},
+    {DXGI_FORMAT_D32_FLOAT, 252},
+    {DXGI_FORMAT_D32_FLOAT_S8X24_UINT, 260},
+    {DXGI_FORMAT_D24_UNORM_S8_UINT, 260},
+};
+
+static int64_t map_format_dxgi_to_metal(DXGI_FORMAT format) {
+  UINT i;
+  for (i = 0; i < ARRAY_SIZE(dxgi_metal_formats); ++i) {
+    if (dxgi_metal_formats[i].dxgi == format) {
+      return dxgi_metal_formats[i].metal;
+    }
+  }
+  return 0;
+}
+
+static DXGI_FORMAT map_format_metal_to_dxgi(int64_t format) {
+  UINT i;
+  for (i = 0; i < ARRAY_SIZE(dxgi_metal_formats); ++i) {
+    if (dxgi_metal_formats[i].metal == format) {
+      return dxgi_metal_formats[i].dxgi;
+    }
+  }
+  return DXGI_FORMAT_UNKNOWN;
+}
