+/* What DXMT stores as a shared texture's private runtime data (src/d3d11/d3d11_texture_device.cpp). */
+struct dxmt_shared_resource {
+  char mach_port_name[54];
+  D3D11_RESOURCE_DIMENSION dimension;
+  union {
+    D3D11_TEXTURE1D_DESC desc1d;
+    D3D11_TEXTURE2D_DESC1 desc2d;
+    D3D11_TEXTURE3D_DESC1 desc3d;
+  } desc;
+  D3DKMT_HANDLE mutex_handle;
+};
+
+static UINT64 metal_call(struct metal_openxr_params *params) {
+  NTSTATUS _status = UNIX_CALL(metal, params);
+  assert(!_status && "metal");
+  return params->ret;
+}
+
+static void dxmt_log(const char *format, ...) {
+  struct metal_openxr_params params = {.op = METAL_LOG};
+  char text[512];
+  va_list args;
+
+  va_start(args, format);
+  vsnprintf(text, sizeof(text), format, args);
+  va_end(args);
+  WARN("%s\n", text);
+  params.message = (UINT64)(uintptr_t)text;
+  metal_call(&params);
+}
+
+static void metal_release_object(UINT64 object) {
+  struct metal_openxr_params params = {.op = METAL_RELEASE, .src = object};
+  if (object) {
+    metal_call(&params);
+  }
+}
+
+static BOOL dxmt_texture_port_name(wine_XrInstance *instance, ID3D11Texture2D *texture, char *name,
+                                   D3DKMT_HANDLE *mutex) {
+  struct dxmt_shared_resource data = {0};
+  D3DKMT_QUERYRESOURCEINFO query = {0};
+  D3DDDI_OPENALLOCATIONINFO2 alloc = {0};
+  D3DKMT_OPENRESOURCE open = {0};
+  D3DKMT_DESTROYALLOCATION destroy = {0};
+  IDXGIResource *resource;
+  HANDLE share;
+  HRESULT hr;
+
+  if (FAILED(ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIResource, (void **)&resource))) {
+    return FALSE;
+  }
+  hr = IDXGIResource_GetSharedHandle(resource, &share);
+  IDXGIResource_Release(resource);
+  if (FAILED(hr)) {
+    WARN("GetSharedHandle failed: %08x\n", hr);
+    return FALSE;
+  }
+
+  /* As DXMT's own import does: the query gives the size, opening the resource the data. */
+  query.hDevice = instance->dxmt_kmt_device;
+  query.hGlobalShare = HandleToULong(share);
+  query.pPrivateRuntimeData = &data;
+  query.PrivateRuntimeDataSize = sizeof(data);
+  if (D3DKMTQueryResourceInfo(&query) || query.PrivateRuntimeDataSize != sizeof(data)) {
+    dxmt_log("not a DXMT shared texture: runtime data of %u bytes", query.PrivateRuntimeDataSize);
+    return FALSE;
+  }
+  open.hDevice = instance->dxmt_kmt_device;
+  open.hGlobalShare = HandleToULong(share);
+  open.NumAllocations = 1;
+  open.pOpenAllocationInfo2 = &alloc;
+  open.pPrivateRuntimeData = &data;
+  open.PrivateRuntimeDataSize = sizeof(data);
+  if (D3DKMTOpenResource2(&open)) {
+    dxmt_log("D3DKMTOpenResource2 failed");
+    return FALSE;
+  }
+  destroy.hDevice = instance->dxmt_kmt_device;
+  destroy.hResource = open.hResource;
+  D3DKMTDestroyAllocation(&destroy);
+
+  memcpy(name, data.mach_port_name, sizeof(data.mach_port_name));
+  name[sizeof(data.mach_port_name) - 1] = 0;
+  *mutex = data.mutex_handle;
+  return TRUE;
+}
+
+/* Opens a shared texture made with a keyed mutex, and the mutex's Metal event, which DXMT
+ * signals and waits on for ReleaseSync and AcquireSync. */
+static BOOL dxmt_open_image(wine_XrInstance *instance, ID3D11Texture2D *texture, UINT64 *metal_texture,
+                            UINT64 *metal_event, D3DKMT_HANDLE *kmt_mutex) {
+  struct metal_openxr_params texture_params = {.op = METAL_OPEN_TEXTURE};
+  struct metal_openxr_params event_params = {.op = METAL_OPEN_EVENT};
+  D3DKMT_OPENKEYEDMUTEX2 open = {0};
+  D3DKMT_HANDLE mutex;
+
+  if (!dxmt_texture_port_name(instance, texture, texture_params.name, &mutex) || !mutex) {
+    return FALSE;
+  }
+  if (!(*metal_texture = metal_call(&texture_params))) {
+    WARN("could not open %s\n", debugstr_a(texture_params.name));
+    return FALSE;
+  }
+  open.hSharedHandle = mutex;
+  open.pPrivateRuntimeData = event_params.name;
+  open.PrivateRuntimeDataSize = 54;
+  if (D3DKMTOpenKeyedMutex2(&open)) {
+    dxmt_log("D3DKMTOpenKeyedMutex2 failed");
+    return FALSE;
+  }
+  *kmt_mutex = open.hKeyedMutex;
+  event_params.name[53] = 0;
+  if (!(*metal_event = metal_call(&event_params))) {
+    WARN("could not open %s\n", debugstr_a(event_params.name));
+    return FALSE;
+  }
+  return TRUE;
+}
