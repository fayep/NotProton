+NTSTATUS metal_openxr(void *args) {
+  struct metal_openxr_params *params = args;
+
+  params->ret = 0;
+  switch (params->op) {
+    case METAL_CREATE_QUEUE:
+      params->ret = (UINT64)(uintptr_t)metal_create_queue();
+      break;
+    case METAL_OPEN_TEXTURE:
+      params->ret = (UINT64)(uintptr_t)metal_open_texture(params->name);
+      break;
+    case METAL_OPEN_EVENT:
+      params->ret = (UINT64)(uintptr_t)metal_open_event(params->name);
+      break;
+    case METAL_COPY:
+      metal_copy((void *)(uintptr_t)params->queue, (void *)(uintptr_t)params->src, (void *)(uintptr_t)params->dst,
+                 (void *)(uintptr_t)params->ready_event, params->ready_value, (void *)(uintptr_t)params->done_event,
+                 params->done_value);
+      break;
+    case METAL_RELEASE:
+      metal_release((void *)(uintptr_t)params->src);
+      break;
+    case METAL_LOG:
+      metal_log((const char *)(uintptr_t)params->message);
+      break;
+  }
   return STATUS_SUCCESS;
 }
