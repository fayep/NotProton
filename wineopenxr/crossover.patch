+/* Only DXMT's shared textures carry the runtime data the swapchain images rely on. */
+static BOOL dxmt_device_is_dxmt(wine_XrInstance *instance) {
+  D3D11_TEXTURE2D_DESC desc = {1, 1, 1, 1, DXGI_FORMAT_R8G8B8A8_UNORM, {1, 0}, D3D11_USAGE_DEFAULT,
+                               D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE, 0,
+                               D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX};
+  ID3D11Texture2D *texture;
+  D3DKMT_HANDLE mutex = 0;
+  char name[64];
+  BOOL ok;
+
+  if (FAILED(ID3D11Device_CreateTexture2D(instance->dxmt_device, &desc, NULL, &texture))) {
+    return FALSE;
+  }
+  ok = dxmt_texture_port_name(instance, texture, name, &mutex) && mutex;
+  ID3D11Texture2D_Release(texture);
+  return ok;
+}
+
+static void dxmt_release(wine_XrInstance *instance) {
+  if (instance->dxmt_device) {
+    ID3D11Device_Release(instance->dxmt_device);
+  }
+  if (instance->dxmt_kmt_device) {
+    D3DKMT_DESTROYDEVICE destroy = {.hDevice = instance->dxmt_kmt_device};
+    D3DKMTDestroyDevice(&destroy);
+  }
+  metal_release_object(instance->metal_queue);
+  instance->dxmt_device = NULL;
+  instance->dxmt_kmt_device = 0;
+  instance->metal_queue = 0;
+}
