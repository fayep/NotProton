+
+/* CrossOver's winevulkan has no instance and device creation callbacks, which
+ * xrCreateVulkanInstanceKHR and xrCreateVulkanDeviceKHR need, so
+ * XR_KHR_vulkan_enable2 is not offered. */
+XrResult WINAPI wine_xrEnumerateInstanceExtensionProperties(const char *layerName,
+                                                            uint32_t propertyCapacityInput,
+                                                            uint32_t *propertyCountOutput,
+                                                            XrExtensionProperties *properties) {
+  XrExtensionProperties *all;
+  uint32_t i, n = 0, kept = 0;
+  XrResult res;
+
+  res = enumerate_instance_extensions(layerName, 0, &n, NULL);
+  if (res != XR_SUCCESS) return res;
+  if (!(all = calloc(n, sizeof(*all)))) return XR_ERROR_OUT_OF_MEMORY;
+  for (i = 0; i < n; ++i) all[i].type = XR_TYPE_EXTENSION_PROPERTIES;
+  res = enumerate_instance_extensions(layerName, n, &n, all);
+  if (res == XR_SUCCESS) {
+    for (i = 0; i < n; ++i)
+      if (strcmp(all[i].extensionName, "XR_KHR_vulkan_enable2")) all[kept++] = all[i];
+    *propertyCountOutput = kept;
+    if (propertyCapacityInput && propertyCapacityInput < kept) res = XR_ERROR_SIZE_INSUFFICIENT;
+    else if (propertyCapacityInput) {
+      for (i = 0; i < kept; ++i) {
+        memcpy(properties[i].extensionName, all[i].extensionName, sizeof(all[i].extensionName));
+        properties[i].extensionVersion = all[i].extensionVersion;
+      }
+    }
+  }
+  free(all);
+  return res;
+}
