@@ -0,0 +1,87 @@
+/* The Metal half of D3D11 on DXMT: DXMT registers the Mach ports of shared textures and
+ * fences under bootstrap names, and these open them the way its own winemetal does. Like it,
+ * they leave the looked-up send rights to the handle and event. */
+
+#import <Metal/Metal.h>
+#include <servers/bootstrap.h>
+
+#include "metal.h"
+
+@interface MTLSharedTextureHandle ()
+- (MTLSharedTextureHandle *)initWithMachPort:(mach_port_t)port;
+@end
+
+@protocol MTLDeviceSharedEventPort
+- (id<MTLSharedEvent>)newSharedEventWithMachPort:(mach_port_t)port;
+@end
+
+static id<MTLDevice> device(void) {
+  static id<MTLDevice> dev;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    dev = MTLCreateSystemDefaultDevice();
+  });
+  return dev;
+}
+
+static mach_port_t look_up(const char *name) {
+  mach_port_t port = MACH_PORT_NULL;
+  if (bootstrap_look_up(bootstrap_port, name, &port) != KERN_SUCCESS) return MACH_PORT_NULL;
+  return port;
+}
+
+void *metal_create_queue(void) {
+  return (__bridge_retained void *)[device() newCommandQueue];
+}
+
+void *metal_open_texture(const char *mach_port_name) {
+  mach_port_t port = look_up(mach_port_name);
+  if (!port) return NULL;
+  MTLSharedTextureHandle *handle = [[MTLSharedTextureHandle alloc] initWithMachPort:port];
+  id<MTLTexture> tex = [device() newSharedTextureWithHandle:handle];
+  return (__bridge_retained void *)tex;
+}
+
+void *metal_open_event(const char *mach_port_name) {
+  mach_port_t port = look_up(mach_port_name);
+  if (!port) return NULL;
+  id<MTLSharedEvent> event = [(id<MTLDeviceSharedEventPort>)device() newSharedEventWithMachPort:port];
+  return (__bridge_retained void *)event;
+}
+
+void metal_copy(void *queue, void *src, void *dst, void *ready_event, uint64_t ready_value, void *done_event,
+                uint64_t done_value) {
+  @autoreleasepool {
+    id<MTLCommandBuffer> cmd = [(__bridge id<MTLCommandQueue>)queue commandBuffer];
+    [cmd encodeWaitForEvent:(__bridge id<MTLSharedEvent>)ready_event value:ready_value];
+    id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+    [blit copyFromTexture:(__bridge id<MTLTexture>)src toTexture:(__bridge id<MTLTexture>)dst];
+    [blit endEncoding];
+    [cmd encodeSignalEvent:(__bridge id<MTLSharedEvent>)done_event value:done_value];
+    [cmd commit];
+  }
+}
+
+void metal_release(void *object) {
+  if (object) CFRelease(object);
+}
+
+/* Into the runtime's log, which users can find, rather than Wine's debug output, which
+ * NotProton does not enable. */
+void metal_log(const char *message) {
+  @autoreleasepool {
+    NSString *path = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Logs/alvrxr.log"];
+    NSDateFormatter *f = [[NSDateFormatter alloc] init];
+    f.dateFormat = @"HH:mm:ss.SSS";
+    NSString *line = [NSString stringWithFormat:@"%@ [wineopenxr %d] %s\n", [f stringFromDate:[NSDate date]],
+                      getpid(), message];
+    NSFileHandle *h = [NSFileHandle fileHandleForWritingAtPath:path];
+    if (!h) {
+      [line writeToFile:path atomically:NO encoding:NSUTF8StringEncoding error:nil];
+      return;
+    }
+    [h seekToEndOfFile];
+    [h writeData:[line dataUsingEncoding:NSUTF8StringEncoding]];
+    [h closeFile];
+  }
+}
